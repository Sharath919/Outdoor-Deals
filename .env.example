# Site
SITE_URL=https://gearandsteer.com
NEXT_PUBLIC_SITE_URL=https://gearandsteer.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Article machine
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=

# Amazon Creators API (product images/prices)
# Partner tag must match the Associates account that owns these credentials
CREATORS_API_CREDENTIAL_ID=
CREATORS_API_CREDENTIAL_SECRET=
CREATORS_API_VERSION=3.1
PAAPI_PARTNER_TAG=novitekka-20

# Affiliate link tracking tag for this site (?tag= on outbound Amazon URLs)
ASSOCIATE_TAG=gearnsteer-20

# Price drop alerts (Resend)
RESEND_API_KEY=
ALERT_FROM_EMAIL=GearAndSteer Alerts <alerts@mail.gearandsteer.com>

# Phase 3 (legacy)
KEEPA_API_KEY=
