# Site
SITE_URL=https://gearandsteer.com
NEXT_PUBLIC_SITE_URL=https://gearandsteer.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Article machine
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=

# Amazon PA-API (product images/prices — partner tag must match these credentials)
PAAPI_ACCESS_KEY=
PAAPI_SECRET_KEY=
PAAPI_PARTNER_TAG=novitekka-20

# Affiliate link tracking tag for this site (?tag= on outbound Amazon URLs)
ASSOCIATE_TAG=gearandsteer-20

# Price drop alerts (Resend)
RESEND_API_KEY=
ALERT_FROM_EMAIL=GearAndSteer Alerts <alerts@mail.gearandsteer.com>

# Phase 3 (legacy)
KEEPA_API_KEY=
